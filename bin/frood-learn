#!/usr/bin/env node
// Global entrypoint for /frood-learn - works from anywhere
import { spawnSync } from "child_process";
import path from "path";

const script = path.join("/home/user/projects/frood", "bin", "frood-learn.mjs");
const result = spawnSync(process.execPath, [script, ...process.argv.slice(2)], {
  stdio: "inherit",
  env: process.env,
});
process.exit(result.status ?? 0);
