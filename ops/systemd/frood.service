# ops/systemd/frood.service — systemd user unit TEMPLATE for Frood.
#
# This file is a template, not a unit: it is filled in by ops/frood_service.py
# (render_unit), which replaces every @PLACEHOLDER@ (@REPO@, @PYTHON@, @PORT@,
# @PATH@, @LOG@). Do not copy it into ~/.config/systemd/user by hand.
#
# Port note: when the port is already taken, uvicorn exits with code 3, which
# Restart=on-failure retries 5 times in 300 s (StartLimitIntervalSec/Burst)
# and then leaves the unit in failed state. Clear it with:
#   systemctl --user reset-failed frood.service

[Unit]
Description=Frood dashboard and Claude Code gateway
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ @REPO@/frood.py --port @PORT@
Restart=on-failure
RestartSec=10
Nice=10
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:@LOG@
StandardError=append:@LOG@
TimeoutStopSec=20
# KillMode=control-group (explicit): Frood's claude agents (core/agent_runtime.py)
# and apps (core/app_manager.py) are its own children; left running they would
# hold the ports the restarted Frood needs. (The desk daemon uses KillMode=process
# for the opposite reason: its runs are detached.)
KillMode=control-group

[Install]
WantedBy=default.target
