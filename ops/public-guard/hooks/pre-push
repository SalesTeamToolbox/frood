#!/bin/sh
# public-guard global pre-push: scan with guard.py, then chain to the repo's own hook.
here=$(cd "$(dirname "$0")" && pwd) || exit 1
tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
python3 "$here/../guard.py" pre-push "$@" < "$tmp" || exit $?
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
hook="$common/hooks/pre-push"
if [ -x "$hook" ] && ! [ "$hook" -ef "$0" ]; then
  "$hook" "$@" < "$tmp"
  exit $?
fi
exit 0
