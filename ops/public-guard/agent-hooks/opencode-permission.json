      "*git receive-pack*": "deny",
      "*git config*--remove-section*": "deny",
      "*git config*--edit*": "deny",
      "*git config*hook*": "deny",
      "*.gitconfig*": "deny",
      "*/etc/gitconfig*": "deny",
      "*.config/git/*": "deny",
      "*/etc/public-guard*": "deny",
      "gh api*PUT*/contents/*": "deny",
