[Unit]
Description=Orchestrator desk driver: act on stream events headlessly

[Service]
Type=simple
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=@NODE@ @REPO@/bin/desk.mjs daemon _run --by @BY@ --interval 30
# systemd --user starts with the default PATH, which does not include mise shims where
# opencode and claude live; @PATH@ is filled by ops/systemd/install.mjs so the critics and
# workers this daemon spawns can resolve opencode and claude.
Environment=PATH=@PATH@
Restart=always
RestartSec=120
# exit 3 = a live session owns the desk lock; restarting would only loop
RestartPreventExitStatus=3
# Stop and restart signal the daemon alone. The critics and workers it launches are detached runs that report
# to their stream when they end; with the default KillMode=control-group a restart killed them mid-run (findings 8,
# plan-desk-daemon-errors: board-close's round-2 critic, 2026-11-24).
KillMode=process

[Install]
WantedBy=default.target
